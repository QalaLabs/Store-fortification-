# CartGuard AI Environment Configuration
# Default mode is MOCK - no AWS credentials required for local development.

# AI Provider Configuration
# Options: mock | bedrock
AI_PROVIDER=mock

# AWS Bedrock Configuration (Optional - only required if AI_PROVIDER=bedrock)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Application Configuration
PORT=3000
NODE_ENV=development

# Storage Configuration
STORAGE_BACKUP_PATH=./data/backup.json
